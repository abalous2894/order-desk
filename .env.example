# Copy to .env and change values before production use:
#   cp .env.example .env

POSTGRES_USER=orderdesk
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=orderdesk

DATABASE_URL=postgresql+psycopg://orderdesk:change-me-in-production@db:5432/orderdesk
OPERATOR_TOKEN=change-me-in-production

# Optional: host port overrides for Docker Compose
# ORDER_DESK_API_PORT=8082
# ORDER_DESK_WEB_PORT=5174
# ORDER_DESK_WEB_TLS_PORT=5443

# Optional: HTTPS CORS origins (when using docker-compose.tls.yml)
# CORS_ORIGINS=https://localhost:5443,http://localhost:5174

# Logging
# LOG_LEVEL=INFO

# Disable FastAPI /docs in production (Docker image defaults to true)
# DISABLE_OPENAPI=true
